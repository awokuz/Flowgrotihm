    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="Narx" type="Integer" array="False" size=""/>
            <declare name="Masofa" type="Real" array="False" size=""/>
            <output expression="&quot;Mahsulot narxini kiriting&quot;" newline="True"/>
            <input variable="Narx"/>
            <output expression="&quot;Yetkazib berish masofasini yozing&quot;" newline="True"/>
            <input variable="Masofa"/>
            <if expression="Narx &gt;=200 and Masofa &gt;=10">
                <then>
                    <output expression="&quot;Hurmatli mijoz Mahsulot yetkazib berish siz uchun tekin&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;Hurmatli mijoz Mahsulot yetkazib berish siz uchun pullik&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
