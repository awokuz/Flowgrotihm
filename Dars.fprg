    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="Ism" type="String" array="False" size=""/>
            <declare name="Yosh" type="Integer" array="False" size=""/>
            <declare name="Boy" type="Real" array="False" size=""/>
